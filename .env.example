# Copie para .env e preencha. O .env nunca deve ser commitado.

# Obrigatório: chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Recomendado: token do GitHub (sem escopos, só leitura de repos públicos).
# Sem ele o limite é 60 req/hora; com ele, 5000 req/hora.
GITHUB_TOKEN=

# Opcional: token do Hugging Face (provider alternativo / embeddings na v1.5)
HF_TOKEN=

# Modelos por etapa do pipeline (map = análise por PR, reduce = agrupamento)
MAP_MODEL=claude-opus-5-5
REDUCE_MODEL=claude-opus-5-5

# Profundidade de raciocínio do modelo: low | medium | high
LLM_EFFORT=medium

# Quantas análises rodam em paralelo (cuidado com rate limit)
MAX_CONCURRENCY=4

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
